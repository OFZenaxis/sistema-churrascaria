# ══════════════════════════════════════════════
# BANCO DE DADOS (Supabase / Prisma)
# ══════════════════════════════════════════════
# Pooler (usado pelo Prisma em runtime via pgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct (usado pelo Prisma Migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ══════════════════════════════════════════════
# SEGURANÇA — Assinatura de Cookies (HMAC-SHA256)
# ══════════════════════════════════════════════
# Gerar com: node -e "require('crypto').randomBytes(64).toString('base64url')"
# NUNCA commite o valor real. Use variável de ambiente no Vercel/Railway.
COOKIE_SECRET=GERE_UMA_STRING_ALEATORIA_SEGURA_AQUI

# ══════════════════════════════════════════════
# QG SUPER ADMIN — JWT e PIN de acesso
# ══════════════════════════════════════════════
# JWT_SECRET: segredo para assinar tokens do painel QG (mínimo 32 chars aleatórios)
# Gerar com: node -e "require('crypto').randomBytes(48).toString('base64url')"
JWT_SECRET=TROCAR_PARA_STRING_ALEATORIA_LONGA_MINIMO_32_CHARS
# SUPER_ADMIN_PIN: PIN numérico para login no /qg-admin (recomendado 8+ dígitos)
SUPER_ADMIN_PIN=TROCAR_PARA_PIN_SEGURO_NUMERICO

# ══════════════════════════════════════════════
# AUTENTICAÇÃO ADMIN (Fase 2 — será substituído por bcrypt)
# ══════════════════════════════════════════════
ADMIN_PASSWORD=sua_senha_aqui

# ══════════════════════════════════════════════
# APP URL — base para links absolutos e webhooks
# ══════════════════════════════════════════════
# Em produção: https://saiudelivery.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ══════════════════════════════════════════════
# DOMÍNIO BASE DA PLATAFORMA — roteamento multi-tenant
# ══════════════════════════════════════════════
# Usado pelo middleware para detectar subdomínios de tenant (slug.BASE_DOMAIN)
# e pelas APIs admin para extrair o slug do header x-store-domain.
# Em produção: saiudelivery.com.br
# Em desenvolvimento: pode omitir (fallback hardcoded para saiudelivery.com.br)
NEXT_PUBLIC_BASE_DOMAIN=saiudelivery.com.br

# ══════════════════════════════════════════════
# MERCADO PAGO (por Tenant — os valores abaixo são do lojista, não da plataforma)
# ══════════════════════════════════════════════
# Public Key — usada no FRONTEND (Payment Brick)
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-seu-public-key
# Access Token — usada no BACKEND (fallback global, sobrescrito pelo StorePaymentConfig)
MP_ACCESS_TOKEN=APP_USR-seu-access-token
# Webhook Secret — para validar assinatura dos webhooks do MP
MP_WEBHOOK_SECRET=sua-chave-secreta-webhook

# ══════════════════════════════════════════════
# SUPABASE STORAGE (Upload de Imagens)
# ══════════════════════════════════════════════
# Project URL: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Anon Key: Supabase Dashboard → Settings → API → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (opcional, recomendado para Server Actions — bypassa RLS)
# Supabase Dashboard → Settings → API → service_role / secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ══════════════════════════════════════════════
# MAPBOX (Geocoding e Mapas de Entrega)
# ══════════════════════════════════════════════
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiVVNVQVJJTyIsImEiOiJUT0tFTiJ9.HASH

# ══════════════════════════════════════════════
# EVOLUTION API v2 (WhatsApp Multi-Tenant)
# ══════════════════════════════════════════════
# URL base da sua instância self-hosted (sem barra final)
# Ex: https://evolution.seudominio.com.br
EVOLUTION_API_URL=https://evolution.seudominio.com.br
# API Key global da Evolution API (definida no docker-compose / .env da Evolution)
EVOLUTION_API_KEY=SUA_EVOLUTION_API_KEY_AQUI

# ══════════════════════════════════════════════
# OBSERVABILIDADE — Better Stack (Logtail)
# ══════════════════════════════════════════════
# Source Token: logs.betterstack.com → Sources → seu source → "Source token"
# Em produção: logs estruturados enviados ao Better Stack via worker_thread (não bloqueia o event loop).
# Em dev / sem token: logs coloridos no terminal via pino-pretty.
BETTERSTACK_TOKEN=
# LOG_LEVEL controla verbosidade (padrão: "info" em prod, "debug" em dev)
# LOG_LEVEL=info

# ══════════════════════════════════════════════
# SUPORTE (WhatsApp de contato da plataforma)
# ══════════════════════════════════════════════
# Número no formato internacional sem + (ex: 5561999999999)
NEXT_PUBLIC_SUPPORT_PHONE=5561999999999
