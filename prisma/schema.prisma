generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======= USERS =======
model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]
}

// ======= ADDRESSES =======
model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label       String   @default("Casa") // "Casa", "Trabalho", "Outro"
  cep         String
  rua         String
  numero      String   // Obrigatório — motoboy precisa saber
  complemento String   // Obrigatório — Lote, Quadra, etc.
  bairro      String
  cidade      String
  estado      String

  // Cache de geocoding
  lat         Float?
  lng         Float?

  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  orders      Order[]
}

// ======= CATALOG =======
enum ProductType {
  CUT
  SIDE
  BEVERAGE
  COMBO
}

model Category {
  id        String   @id @default(uuid())
  name      String
  products  Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  type        ProductType
  imageUrl    String?

  // Controle de estoques/cardápio
  isActive    Boolean   @default(true)

  // For combos: how many sides are allowed?
  maxSides    Int?      @default(0)

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])

  orderItems  OrderItem[]
}

// ======= ORDERS =======
enum OrderStatus {
  PENDING
  PREPARING
  READY_FOR_PICKUP
  DISPATCHED
  DELIVERED
  CANCELED
}

model Order {
  id                    String      @id @default(uuid())
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
  customerName          String // Fallback if no user is registered
  customerPhone         String
  deliveryAddress       String?  // String formatada para exibição

  // Referência ao Address salvo do cliente
  addressId             String?
  address               Address?    @relation(fields: [addressId], references: [id])

  status                OrderStatus @default(PENDING)
  totalAmount           Float
  paymentMethod         String?     // 'PIX' | 'CARD' | 'CASH'
  changeFor             Float?      // Troco para X (apenas se CASH)
  paymentStatus         String?     // e.g., 'APPROVED', 'PENDING'

  // The differential feature requested by the user
  estimatedDeliveryTime Int?        // Represented in minutes

  driverLat             Float?      // GPS Latitude do motoboy
  driverLng             Float?      // GPS Longitude do motoboy
  customerLat           Float?      // GPS Latitude do destino
  customerLng           Float?      // GPS Longitude do destino

  deliveryZoneId        String?
  deliveryZone          DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])

  delivery              Delivery?

  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

enum MeatDoneness {
  RARE          // Mal passado
  MEDIUM_RARE   // Ao ponto para mal
  MEDIUM        // Ao ponto
  MEDIUM_WELL   // Ao ponto para bem
  WELL_DONE     // Bem passado
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id])

  productId   String
  product     Product        @relation(fields: [productId], references: [id])

  quantity    Int            @default(1)
  unitPrice   Float

  // Mandatory for Cuts
  doneness    MeatDoneness?

  // JSON to store selected sides for Combos (e.g. ["Arroz", "Fritas"])
  comboSides  String?
}

// ======= LOGISTICS =======
model DeliveryZone {
  id          String   @id @default(uuid())
  name        String   // e.g., "Centro", "Jardim Botânico"
  fee         Float    // Delivery fee for this zone

  orders      Order[]
}

model Delivery {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])

  driverName  String
  driverPhone String?

  dispatchedAt DateTime @default(now())
  deliveredAt  DateTime?
}

// ======= STORE SETTINGS =======
model StoreSettings {
  id     String  @id @default("singleton")
  isOpen Boolean @default(true)
}
