generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======= PLATFORM & SAAS =======
enum SubscriptionTier {
  BASIC
  PRO
  ENTERPRISE
}

model Store {
  id           String  @id @default(uuid())
  slug         String  @unique // Ex: "minha-churrascaria" (usado na URL)
  customDomain String? @unique
  name         String
  document     String? // CNPJ/CPF

  // Branding por Tenant
  logoUrl       String?
  coverImageUrl String?
  brandColor    String  @default("#10b981")
  themeId       String  @default("classic-light")
  phone         String?
  city          String?
  tagline       String?

  // SaaS Control
  tier     SubscriptionTier @default(BASIC)
  isActive Boolean          @default(true)
  subscriptionStatus       String  @default("PENDING")
  abacatepaySubscriptionId String?

  // Feature Flags
  features Json? // Ex: { "kds": false, "gamification": false, "upsell": true }

  isOpen     Boolean @default(true)
  kitchenPin String? // PIN numérico para travar/destravar o KDS (por tenant)

  // Configurações de Entrega por GPS
  storeAddress      String? // Endereço completo para geocodificação
  storeLat          Float? // Latitude da loja (preenchida via Mapbox)
  storeLng          Float? // Longitude da loja (preenchida via Mapbox)
  baseDeliveryFee   Float   @default(0) // Taxa base independente da distância
  deliveryFeePerKm  Float   @default(0) // Acréscimo por KM rodado
  maxDeliveryRadius Float   @default(10) // Raio máximo de entrega em KM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações SaaS
  paymentConfig StorePaymentConfig?
  users         User[] // Staff
  customers     Customer[] // End users
  categories    Category[]
  products      Product[]
  orders        Order[]
  deliveryZones DeliveryZone[]
}

model StorePaymentConfig {
  id      String @id @default(uuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  mpAccessToken      String?
  mpPublicKey        String?
  pixDiscountPercent Float?  @default(0)
}

// ======= STAFF (Lojistas, Gerentes, Motoboys, SuperAdmins) =======
enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  DRIVER
}

model User {
  id      String  @id @default(uuid())
  storeId String? // Opcional apenas para SUPER_ADMIN global
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name     String
  phone    String  @unique // Pode ser usado como login junto com senha
  email    String? @unique
  password String?
  role     Role    @default(MANAGER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======= CUSTOMERS (Clientes Finais) =======
model Customer {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]

  @@unique([storeId, phone]) // Um telefone só pode ter um cadastro único por loja
  @@index([storeId])
}

// ======= ADDRESSES =======
model Address {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label       String @default("Casa")
  cep         String
  rua         String
  numero      String
  complemento String
  bairro      String
  cidade      String
  estado      String

  lat Float?
  lng Float?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  orders Order[]
}

// ======= CATALOG =======
model Category {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name     String
  products Product[]
}

model Product {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float
  imageUrl    String?

  isActive Boolean @default(true)
  maxSides Int?    @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
  options    ProductOption[] // BUG-020: upsell / acompanhamentos configuráveis

  @@index([storeId])
}

// ======= PRODUCT OPTIONS (BUG-020) =======
// Opcionais configuráveis por produto — ex: ponto da carne, acompanhamentos, adicionais
model ProductOption {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Ex: "Ponto da Carne", "Acompanhamentos", "Adicionais"
  groupName String

  // Ex: "Ao ponto", "Fritas", "Bacon extra"
  label String

  // Preço adicional da opção (0 = incluso sem custo)
  priceAdd Float @default(0)

  // Controla se a opção está disponível para seleção
  isActive Boolean @default(true)

  // Ordem de exibição dentro do grupo
  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

// ======= ORDERS =======
enum OrderStatus {
  PENDING
  PREPARING
  READY_FOR_PICKUP
  DISPATCHED
  DELIVERED
  CANCELED
}

model Order {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  deliveryAddress String?

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  status        OrderStatus @default(PENDING)
  totalAmount   Float
  paymentMethod String? // 'PIX' | 'CARD' | 'CASH'
  changeFor     Float?
  paymentStatus String?

  estimatedDeliveryTime Int?

  driverLat   Float?
  driverLng   Float?
  customerLat Float?
  customerLng Float?

  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  delivery Delivery?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

enum MeatDoneness {
  RARE
  MEDIUM_RARE
  MEDIUM
  MEDIUM_WELL
  WELL_DONE
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity   Int           @default(1)
  unitPrice  Float
  doneness   MeatDoneness?
  comboSides String?
}

// ======= LOGISTICS =======
model DeliveryZone {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name          String
  fee           Float   @default(0)
  estimatedTime String? // Ex: "30-40 min"
  isActive      Boolean @default(true)

  orders Order[]
}

model Delivery {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  driverName  String
  driverPhone String?

  dispatchedAt DateTime  @default(now())
  deliveredAt  DateTime?
}

// ======= MARKETING / LEADS =======
model PartialLead {
  id      String  @id @default(uuid())
  storeId String? // tenant de origem (nullable para manter compatibilidade com leads existentes)

  name      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  @@index([storeId])
}
